    "editorGutter.addedBackground": "#6E8B67",
    "editorGutter.deletedBackground": "#B4473D",
    "editorError.foreground": "#B4473D",
    "editorWarning.foreground": "#A87927",
    "editorInfo.foreground": "#587C91",
    "editorHint.foreground": "#6E8B67",
    "editorWidget.background": "#FFF9F0",
    "editorWidget.border": "#D8CDBB",
    "editorSuggestWidget.background": "#FFF9F0",
    "editorSuggestWidget.foreground": "#403A32",
    "editorSuggestWidget.selectedBackground": "#E9DDC8",
    "editorHoverWidget.background": "#FFF9F0",
    "editorHoverWidget.border": "#D8CDBB",
    "editorGroupHeader.tabsBackground": "#EDE4D6",
    "editorGroupHeader.tabsBorder": "#DDD2C1",
    "tab.activeBackground": "#FBF7EF",
    "tab.activeForeground": "#403A32",
    "tab.inactiveBackground": "#EDE4D6",
    "tab.inactiveForeground": "#887D6E",
    "tab.hoverBackground": "#F4EEE3",
    "tab.border": "#DDD2C1",
    "tab.activeBorderTop": "#A86F4D",
    "tab.unfocusedActiveBorderTop": "#C9B69A",
    "breadcrumb.foreground": "#887D6E",
    "breadcrumb.focusForeground": "#403A32",
    "breadcrumb.activeSelectionForeground": "#8B5D3C",
    "panel.background": "#F0E9DD",
    "panel.border": "#DDD2C1",
    "panelTitle.activeForeground": "#403A32",
    "panelTitle.inactiveForeground": "#887D6E",
    "panelTitle.activeBorder": "#A86F4D",
    "terminal.background": "#F4EEE3",
    "terminal.foreground": "#403A32",
    "terminalCursor.foreground": "#A86F4D",
    "terminal.selectionBackground": "#E5D7BD",
    "terminal.ansiBlack": "#51483D",
    "terminal.ansiRed": "#B4473D",
    "terminal.ansiGreen": "#617D58",
    "terminal.ansiYellow": "#A87927",
    "terminal.ansiBlue": "#587C91",
    "terminal.ansiMagenta": "#98718D",
    "terminal.ansiCyan": "#548985",
    "terminal.ansiWhite": "#F5EFE4",
    "terminal.ansiBrightBlack": "#817665",
    "terminal.ansiBrightRed": "#C75B50",
    "terminal.ansiBrightGreen": "#78936F",
    "terminal.ansiBrightYellow": "#C39A4A",
    "terminal.ansiBrightBlue": "#7195A8",
    "terminal.ansiBrightMagenta": "#B18BA6",
    "terminal.ansiBrightCyan": "#75A6A0",
    "terminal.ansiBrightWhite": "#FFFCF6",
    "statusBar.background": "#E3D7C4",
    "statusBar.foreground": "#51483D",
    "statusBar.border": "#D2C3AC",
    "statusBar.debuggingBackground": "#B4473D",
    "statusBar.debuggingForeground": "#FFF9EF",
    "statusBar.noFolderBackground": "#E3D7C4",
    "statusBar.noFolderForeground": "#51483D",
    "titleBar.activeBackground": "#E9E0D1",
    "titleBar.activeForeground": "#51483D",
    "titleBar.inactiveBackground": "#E9E0D1",
    "titleBar.inactiveForeground": "#918575",
    "menubar.selectionBackground": "#DDD0BB",
    "menubar.selectionForeground": "#403A32",
    "menu.background": "#FFF9F0",
    "menu.foreground": "#403A32",
    "menu.selectionBackground": "#E9DDC8",
    "menu.selectionForeground": "#39332B",
    "menu.border": "#D8CDBB",
    "scrollbarSlider.background": "#C8BBA780",
    "scrollbarSlider.hoverBackground": "#A99A8580",
    "scrollbarSlider.activeBackground": "#8E7E6880",
    "minimap.background": "#F6F0E6",
    "gitDecoration.addedResourceForeground": "#617D58",
    "gitDecoration.modifiedResourceForeground": "#A87927",
    "gitDecoration.deletedResourceForeground": "#B4473D",
    "gitDecoration.untrackedResourceForeground": "#548985",
    "gitDecoration.ignoredResourceForeground": "#A69B8B",
    "diffEditor.insertedTextBackground": "#DCE8D780",
    "diffEditor.removedTextBackground": "#F2DCD780",
    "merge.currentHeaderBackground": "#DCE8D7",
    "merge.incomingHeaderBackground": "#E9DDC8",
    "notificationCenterHeader.background": "#E9E0D1",
    "notifications.background": "#FFF9F0",
    "notifications.foreground": "#403A32",
    "notifications.border": "#D8CDBB",
    "extensionButton.prominentBackground": "#8C6849",
    "extensionButton.prominentForeground": "#FFF9EF",
    "extensionButton.prominentHoverBackground": "#755438"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#857967",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Modifiers & control flow (italic)",
      "scope": [
        "storage.modifier",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Declarations (bold)",
      "scope": [
        "entity.name.type.class",
        "entity.name.function.definition"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#98613F"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#617D58"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#A87927"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#6F5A36"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#587C91"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#403A32"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#8B5D3C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#98718D"
      }
    },
    {
      "name": "Operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#766D60"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#98613F"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7C6745"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#8B5D3C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#587C91",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Inserted diff",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#496A43"
      }
    },
    {
      "name": "Deleted diff",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#A13F36"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#B4473D",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "variable": "#403A32",
    "parameter": {
      "foreground": "#8B5D3C",
      "italic": true
    },
    "function": "#6F5A36",
    "method": "#6F5A36",
    "class": "#587C91",
    "interface": "#587C91",
    "type": "#587C91",
    "property": "#98718D",
    "enumMember": "#A87927",
    "namespace": "#98613F",
    "comment": {
      "foreground": "#857967",
      "italic": true
    }
  }
}
