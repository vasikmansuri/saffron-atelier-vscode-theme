    "activityBar.activeBackground": "#F5EFE4",
    "activityBarBadge.background": "#A86F4D",
    "activityBarBadge.foreground": "#FFF9EF",
    "sideBar.background": "#F0E9DD",
    "sideBar.foreground": "#51483D",
    "sideBar.border": "#DDD2C1",
    "sideBarTitle.foreground": "#403A32",
    "sideBarSectionHeader.background": "#EAE1D3",
    "sideBarSectionHeader.foreground": "#655A4B",
    "list.activeSelectionBackground": "#E1D2B8",
    "list.activeSelectionForeground": "#39332B",
    "list.inactiveSelectionBackground": "#EAE0D0",
    "list.inactiveSelectionForeground": "#403A32",
    "list.hoverBackground": "#E8DECE",
    "list.hoverForeground": "#39332B",
    "list.focusBackground": "#E5D7BD",
    "list.focusForeground": "#39332B",
    "list.highlightForeground": "#8B5D3C",
    "tree.indentGuidesStroke": "#D8CDBB",
    "editor.background": "#FBF7EF",
    "editor.foreground": "#403A32",
    "editorLineNumber.foreground": "#A69A88",
    "editorLineNumber.activeForeground": "#65594A",
    "editorCursor.foreground": "#A86F4D",
    "editor.selectionBackground": "#E5D7BD",
    "editor.inactiveSelectionBackground": "#EEE4D3",
    "editor.lineHighlightBackground": "#F4EEE3",
    "editorLineNumber.dimmedForeground": "#C0B5A4",
    "editorWhitespace.foreground": "#E5DCCF",
    "editorIndentGuide.background1": "#E6DCCB",
    "editorIndentGuide.activeBackground1": "#C9B69A",
    "editorRuler.foreground": "#E7DDCE",
    "editorBracketMatch.background": "#E9DDC8",
    "editorBracketMatch.border": "#B99A73",
    "editor.findMatchBackground": "#EAD39A",
    "editor.findMatchHighlightBackground": "#F2E6C5",
    "editor.wordHighlightBackground": "#E9E0D0",
    "editor.wordHighlightStrongBackground": "#DCC9A8",
